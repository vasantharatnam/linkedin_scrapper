{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "description": "API for extracting structured data from LinkedIn profile pages",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:schema": "tsx src/scripts/verify-profile-schema.ts",
    "verify:url": "tsx src/scripts/verify-linkedin-url.ts",
    "verify:http-client": "tsx src/scripts/verify-linkedin-http-client.ts",
    "verify:auth": "tsx src/scripts/verify-linkedin-auth.ts",
    "fixtures:sanitize": "tsx src/scripts/sanitize-linkedin-fixture.ts",
    "verify:fixtures": "tsx src/scripts/verify-fixtures.ts",
    "verify:endpoints": "tsx src/scripts/verify-linkedin-endpoints.ts",
    "verify:normalized-response": "tsx src/scripts/verify-linkedin-normalized-response.ts",
    "verify:profile-basic": "tsx src/scripts/verify-linkedin-profile-basic.ts",
    "verify:profile-sections": "tsx src/scripts/verify-linkedin-profile-sections.ts",
    "verify:profile-skills": "tsx src/scripts/verify-linkedin-profile-skills.ts",
    "verify:profile-service": "tsx src/scripts/verify-linkedin-profile-service.ts",
    "verify:profile-route": "tsx src/scripts/verify-profile-route.ts",
    "verify:api-key-auth": "tsx src/scripts/verify-api-key-auth.ts",
    "verify:cache-rate-limit": "tsx src/scripts/verify-cache-rate-limit.ts",
    "verify:openapi": "tsx src/scripts/verify-openapi.ts",
    "verify:deployment": "tsx src/scripts/verify-deployment.ts",
    "verify:repository-safety": "tsx src/scripts/verify-repository-safety.ts"
  },
  "keywords": [
    "linkedin",
    "profile",
    "scraper",
    "api",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
